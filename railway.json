{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "database": {
      "image": "mysql:8",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${{ secrets.DATABASE_PASSWORD }}",
        "MYSQL_DATABASE": "bidverse_db"
      }
    },
    "backend": {
      "dockerfile": "./bidverse-backend/backend.Dockerfile",
      "environment": {
        "SPRING_DATASOURCE_URL": "jdbc:mysql://database:3306/bidverse_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true",
        "SPRING_DATASOURCE_USERNAME": "root",
        "SPRING_DATASOURCE_PASSWORD": "${{ secrets.DATABASE_PASSWORD }}",
        "SPRING_JPA_HIBERNATE_DDL_AUTO": "update",
        "SPRING_JPA_SHOW_SQL": "false",
        "SERVER_PORT": "2000",
        "SERVER_ADDRESS": "0.0.0.0"
      }
    },
    "frontend": {
      "dockerfile": "./bidverse-frontend/frontend.Dockerfile",
      "environment": {
        "VITE_API_BASE_URL": ""
      }
    }
  }
}
